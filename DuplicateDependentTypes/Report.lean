import DuplicateDependentTypes.Cluster
import DuplicateDependentTypes.Workspace

/-!
# The report

Every class is annotated per member: source range and snippet, signature, size of the proof. A
member is not an *independent* proof if its proof reaches another member (through the values of
theorems, breadth-first, at most `reachBudget` of them), if it is deprecated, or if it is declared
at the same position as another member (generated by one command). Classes with at least two
independent proofs are the duplicate groups, except those that mirror another (`dropMirrors`).
Their fields are described in the README.
-/

namespace DuplicateDependentTypes

open Lean Meta System

def pairHeartbeats : Nat := 200000 * 1000
def reachBudget : Nat := 1000
def trivialObjs : Nat := 128
def trivialChars : Nat := 110
def contextLines : Nat := 3
def maxDeclLines : Nat := 60

structure Member where
  decl : Decl
  file? : Option FilePath := none
  line : Nat := 0
  endLine : Nat := 0
  /-- The source from line `srcFrom`: the declaration with context lines. -/
  src : String := ""
  srcFrom : Nat := 0
  sig : String := ""
  /-- Why the proof is not independent. -/
  dep? : Option String := none
  /-- The declaration whose command generated this one. -/
  gen? : Option Lean.Name := none
  /-- `same` / `defeq` / `not defeq` relative to the first independent proof. -/
  rel? : Option String := none
  trivial : Bool := false
  simp : Bool := false
  used : Bool := false
  deriving Inhabited

/-! ## Members -/

/-- The first of `targets` that the proof of `n` mentions, directly or through other theorems. -/
def reaches (env : Environment) (n : Lean.Name) (targets : NameSet) : Option Lean.Name := Id.run do
  let mut queue := #[n]
  let mut seen : NameSet := {}
  let mut i := 0
  while i < queue.size && i < reachBudget do
    let some (.thmInfo t) := env.find? queue[i]! | i := i + 1; continue
    i := i + 1
    for c in t.value.getUsedConstants do
      if targets.contains c then return some c
      unless seen.contains c do seen := seen.insert c; queue := queue.push c
  return none

def ppSig (n : Lean.Name) : MetaM String := do
  let r ← guarded pairHeartbeats do return (← PrettyPrinter.ppSignature n).fmt.pretty 100
  modify fun s => { s with cache := {} }
  match r with
  | .ok s => return if s.length > 2000 then (s.take 2000).toString ++ " …" else s
  | .error _ => return toString n

/-- Another declaration of `n`'s module, not in `others`, that starts where `n` does and is longer:
the command that generated `n` (`to_additive`, `to_dual`, `simps`, …). -/
def generator? (n : Lean.Name) (others : NameSet) (range : DeclarationRange) : MetaM (Option Lean.Name) := do
  let env ← getEnv
  let some i := env.getModuleIdxFor? n | return none
  for c in env.header.moduleData[i.toNat]!.constants do
    if c.name == n || others.contains c.name || c.name.isInternalDetail then continue
    if let some r ← findDeclarationRanges? c.name then
      if r.range.pos.line == range.pos.line && r.range.endPos.line > range.endPos.line then
        return some c.name
  return none

/-- A member: everything but `rel?` and `used`. -/
def annotateMember (fileOf : Lean.Name → Option FilePath) (others : NameSet) (d : Decl) : MetaM Member := do
  let env ← getEnv
  let n := d.name
  let some (.thmInfo t) := env.find? n | return { decl := d }
  let r? ← findDeclarationRanges? n
  let mut m : Member := { decl := d, sig := ← ppSig n, simp := (← getSimpTheorems).isLemma (.decl n) }
  if Linter.isDeprecated env n then m := { m with dep? := some "deprecated" }
  else if let some o := reaches env n others then m := { m with dep? := some s!"uses {o}" }
  if let some r := r? then m := { m with gen? := ← generator? n others r.range }
  let small := (← t.value.numObjs) ≤ trivialObjs
  let some r := r? | return { m with trivial := small }
  let (a, b) := (r.range.pos.line, r.range.endPos.line)
  let some f := fileOf d.module | return { m with line := a, endLine := b, trivial := small }
  let lines := (← IO.FS.readFile f).splitOn "\n" |>.toArray
  let (hiDecl, hi) := if b - a + 1 > maxDeclLines then (a + maxDeclLines - 1, a + maxDeclLines - 1)
    else (b, min lines.size (b + contextLines))
  let lo := max 1 (a - contextLines)
  let text := "\n".intercalate (lines.extract (a - 1) b).toList
  let proof := match text.splitOn ":=" with
    | _ :: rest@(_ :: _) => ":=".intercalate rest
    | _ => text
  let proof := " ".intercalate (((proof.replace "\n" " ").splitOn " ").filter (!·.isEmpty))
  return { m with file? := some f, line := a, endLine := hiDecl, srcFrom := lo,
                  src := "\n".intercalate (lines.extract (lo - 1) hi).toList,
                  trivial := small && proof.length ≤ trivialChars }

/-- The members of a class, with `rel?` filled in for the independent proofs. -/
def annotateClass (fileOf : Lean.Name → Option FilePath) (ds : Array Decl) : MetaM (Array Member) := do
  let names : NameSet := ds.foldl (·.insert ·.name) {}
  let ms ← ds.mapM fun d => annotateMember fileOf (names.erase d.name) d
  -- declarations at one position come from one command (`to_additive`, `to_dual`, `alias`, …):
  -- one proof, kept for the declaration with the full range
  let mut ms := ms.mapIdx fun i m =>
    let first := fun (j : Nat) => let o := ms[j]!
      j != i && o.decl.module == m.decl.module && o.line == m.line &&
        (o.endLine > m.endLine || (o.endLine == m.endLine && j < i))
    match (List.range ms.size).find? first, m.dep? with
    | some j, none => if m.line > 0 then { m with dep? := some s!"same declaration as {ms[j]!.decl.name}" } else m
    | _, _ => m
  let ind := (List.range ms.size).filter (ms[·]!.dep?.isNone)
  let some i₀ := ind.head? | return ms
  let t₀ := ms[i₀]!.decl.type
  for i in ind do
    let t := ms[i]!.decl.type
    let rel ← if i == i₀ || t == t₀ then pure "same" else do
      let r ← guarded pairHeartbeats (isDefEq t₀ t)
      modify fun s => { s with cache := {} }
      pure (if let .ok true := r then "defeq" else "not defeq")
    ms := ms.modify i ({ · with rel? := some rel })
  return ms

/-- Drop the groups that mirror another: a group with a member generated from a member of another
group (the `to_dual` images of a duplicate pair are a duplicate pair too) goes if that group has no
generated members or is kept. -/
def dropMirrors (groups : Array (Array Member)) : Array (Array Member) := Id.run do
  let mut groupOf : NameMap Nat := {}
  for h : g in [:groups.size] do
    for m in groups[g] do groupOf := groupOf.insert m.decl.name g
  let sources := groups.mapIdx fun g ms =>
    ms.filterMap fun m => m.gen?.bind (groupOf.get? ·) |>.filter (· != g)
  let mut kept : Std.HashSet Nat := {}
  for h : g in [:groups.size] do
    unless sources[g]!.any fun s => sources[s]!.isEmpty || kept.contains s do kept := kept.insert g
  return (List.range groups.size).filter kept.contains |>.toArray.map (groups[·]!)

/-- Mark the members that a constant outside their group mentions. -/
def markUsed (groups : Array (Array Member)) (jobs : Nat) : MetaM (Array (Array Member)) := do
  let mut groupOf : NameMap Nat := {}
  for h : g in [:groups.size] do
    for m in groups[g] do groupOf := groupOf.insert m.decl.name g
  let gOf := groupOf
  -- `c` belongs to group `g` when it is a member or generated from one (`m._proof_1`, `m.eq_1`)
  let inGroup (g : Nat) (c : Lean.Name) : Bool := Id.run do
    let mut c := c
    while !c.isAnonymous do
      if gOf.get? c == some g then return true
      c := c.getPrefix
    return false
  let cs := (← getEnv).constants.map₁.fold (fun a _ c => a.push c) #[]
  let used ← spawnAll ((shares cs.size jobs 4096).map fun idxs => do
    let mut used : NameSet := {}
    for i in idxs do
      let c := cs[i]!
      let hit := fun k (acc : Array Lean.Name) => if gOf.contains k then acc.push k else acc
      let ks := (c.value? (allowOpaque := true)).elim #[] (·.foldConsts #[] hit)
      for k in c.type.foldConsts ks hit do
        unless used.contains k || inGroup (gOf.get! k) c.name do used := used.insert k
    return used)
  return groups.map (·.map fun m => { m with used := used.any (·.contains m.decl.name) })

/-! ## Group fields -/

def package (m : Lean.Name) : String :=
  let r := m.getRoot.toString
  if ["Init", "Std", "Lean", "Lake"].contains r then "core" else r

/-- The directory of a module, at most two levels deep (three below `Data`). -/
def area (m : Lean.Name) : List String :=
  let cs := m.components.map toString
  cs.take (min (cs.length - 1) (if cs[1]? == some "Data" then 3 else 2))

def location (a b : Lean.Name) : String :=
  if package a != package b then "cross-package"
  else if a == b then "same file"
  else if area a != area b then "cross-area"
  else "cross-file"

def isInternal (n : Lean.Name) : Bool :=
  n.components.any fun c => ["Internal", "InternalConsumers", "Simproc", "Grind", "Omega", "Sym",
    "Tactic", "Meta"].contains c.toString

/-- A last name component up to the swap of a symmetric or dual pair of words. -/
def symShape (s : String) : String :=
  [("monomorphism", "epimorphism"), ("mono", "epi"), ("ge", "le"), ("gt", "lt"), ("inf", "sup"),
    ("bot", "top"), ("right", "left"), ("min", "max"), ("iio", "ioi"), ("iic", "ici"), ("ico", "ioc"),
    ("lower", "upper"), ("pred", "succ"), ("below", "above"), ("antitone", "monotone"),
    ("superset", "subset"), ("ssuperset", "ssubset"), ("substr", "subst"), ("inr", "inl"),
    ("snd", "fst"), ("mpr", "mp"), ("second", "first"), ("rhs", "lhs")].foldl
    (fun s (a, b) => s.replace a b) (s.replace "'" "").toLower

/-- `A_eq_B` ↦ `(A, B)` (also `ne`, `iff`; a trailing `_iff` ignored). -/
def sides? (s : String) : Option (List String × List String) := do
  let ts := (s.replace "'" "").splitOn "_"
  let ts := if ts.length > 2 && ts.getLast? == some "iff" then ts.dropLast else ts
  let sep ← ["eq", "ne", "iff"].find? fun sep => ts.count sep == 1
  let i ← ts.idxOf? sep
  guard (0 < i && i + 1 < ts.length)
  return (ts.take i, ts.drop (i + 1))

/-- Why `a`, `b` look like an API pair written twice on purpose, or `""`. -/
def apiTwin (a b : Member) : String :=
  let (na, nb) := (a.decl.name, b.decl.name)
  let (la, lb) := (na.getString!, nb.getString!)
  let sameNs := na.getPrefix == nb.getPrefix
  let sameMod := a.decl.module == b.decl.module
  let differ := b.rel? != some "same"
  if isInternal na || isInternal nb then "internal"
  else if differ && sameMod && a.line + 12 ≥ b.line && b.line + 12 ≥ a.line && a.line > 0 then "adjacent"
  else if differ && sameNs && sameMod &&
      (match sides? la, sides? lb with | some (x, y), some (x', y') => x == y' && y == x' | _, _ => false) then
    "orientation"
  else if differ && sameMod && na != nb && na.toString.replace "'" "" == nb.toString.replace "'" "" then "primed"
  else if differ && sameNs && la != lb && (la.replace "contains" "mem" == lb.replace "contains" "mem") then
    "contains-mem"
  else if location a.decl.module b.decl.module != "cross-package" && la.replace "'" "" != lb.replace "'" "" &&
      symShape la == symShape lb then "symmetric names"
  else if differ && sameMod && (a.simp || b.simp) then "simp"
  else ""

def summary (xs : List Bool) (all part no : String) : String :=
  if xs.all id then all else if xs.any id then part else no

def groupJson (id r : Nat) (wsDir : FilePath) (url? : Lean.Name → Option String) (ms : Array Member) : Json :=
  let ind := ms.filter (·.dep?.isNone)
  let (a, b) := (ind[0]!, ind[1]!)
  let pkgs := (ind.map (package ·.decl.module)).toList.eraseDups.toArray.qsort fun x y =>
    (x == "core" && y != "core") || ((x == "core") == (y == "core") && x < y)
  let levels := ["same", "defeq", "not defeq"].filter fun l => (ind.extract 1).any (·.rel? == some l)
  let relPath (f : FilePath) := match (f.toString.dropPrefix? (wsDir.toString ++ "/")) with
    | some r => r.toString
    | none => f.toString
  let member (m : Member) := Json.mkObj [
    ("name", toJson m.decl.name), ("module", toJson m.decl.module), ("file", toJson (m.file?.map relPath)),
    ("line", m.line), ("end", m.endLine), ("from", m.srcFrom), ("src", m.src), ("sig", m.sig),
    ("url", toJson (if m.line == 0 then none else (url? m.decl.module).map (· ++ s!"#L{m.line}-L{m.endLine}"))),
    ("dep", toJson m.dep?), ("gen", toJson m.gen?), ("rel", toJson m.rel?), ("trivial", m.trivial), ("used", m.used)]
  Json.mkObj [
    ("id", toString id), ("r", r), ("a", toJson a.decl.name), ("b", toJson b.decl.name), ("n", ms.size),
    ("m", toJson ((ind.map (·.decl.module.toString)).toList.eraseDups.toArray.qsort (· < ·))),
    ("sk", toJson levels), ("loc", location a.decl.module b.decl.module), ("pk", "↔".intercalate pkgs.toList),
    ("tr", summary (ind.map (·.trivial)).toList "all trivial" "some trivial" "substantive"),
    ("u", summary (ind.map (·.used)).toList "all used" "one side unused" "none used"),
    ("tw", apiTwin a b), ("members", Json.arr (ms.map member))]

/-! ## Outputs -/

/-- The page: the assets with the data spliced in (`<\/` so that no string ends the script). -/
def html (info : Json) (lines : Array String) : String :=
  let data := s!"window.META={info.compress};\nwindow.GROUPS=[\n{",\n".intercalate lines.toList}];"
  (include_str "../assets/index.html")
    |>.replace "/*STYLE*/" (include_str "../assets/style.css")
    |>.replace "/*SCRIPT*/" (include_str "../assets/app.js")
    |>.replace "/*DATA*/" (data.replace "</" "<\\/")

end DuplicateDependentTypes
